PORT=3001

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/portfolio
# For MongoDB Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/portfolio

# Nodemailer config (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
CONTACT_RECEIVER=your_email@gmail.com

# Admin secret for protected routes
ADMIN_SECRET=change_this_secret
JWT_SECRET=your_jwt_secret_here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
